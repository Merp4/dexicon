# Dexicon environment
#
# Copy to .env and edit:   cp .env.example .env
#
# SECRETS MODEL — secrets are NEVER committed. This template is the only tracked
# file; `.env` and `secrets/` are gitignored. Docker Compose reads `.env`
# automatically and substitutes ${VAR} into docker-compose.yml at runtime, so real
# values reach the containers without ever entering the repository.
# See docs/10-security-secrets.md.
#
# Every variable below has a working default except WORKSPACE_ROOT. A fresh
# `docker compose up -d` with an unedited copy of this file will start.

# ── What to index ─────────────────────────────────────────────────────────────

# Host directory bind-mounted READ-ONLY at /workspaces inside the container.
# Point this at the parent folder of the repositories you want indexed; Dexicon
# can only see paths underneath it.
WORKSPACE_ROOT=./workspaces

# ── Network exposure ──────────────────────────────────────────────────────────

# Host port for the UI, REST API and MCP endpoint. Deliberately not 8080.
DEXICON_PORT=8477

# Bind address. Leave as loopback unless you need to reach Dexicon from another
# machine; there is no TLS and the token is the only credential.
DEXICON_BIND=127.0.0.1

# Qdrant and Ollama publish NO host ports. To reach them for debugging, use the
# debug overlay, which maps them to non-standard ports:
#   docker compose -f docker-compose.yml -f docker-compose.debug.yml up -d

# ── Embedding ─────────────────────────────────────────────────────────────────

# Default model for new corpora. Pinned per corpus at creation; changing this does
# not migrate existing corpora (that is an explicit rebuild). Candidates and the
# trade-offs are in docs/04-ingestion.md.
DEXICON_EMBEDDING_MODEL=nomic-embed-text

# ── Embedding providers ──────────────────────────────────────────────────────
# Ollama is configured by default and needs nothing here. Add a hosted provider by
# naming its kind and the ENVIRONMENT VARIABLE that holds its key — never the key
# itself. This file is gitignored; .env.example is not, and a key pasted into the
# wrong one is a key in your history.
#
# DEXICON__EMBEDDING__PROVIDERS__openai__KIND=OpenAI
# DEXICON__EMBEDDING__PROVIDERS__openai__APIKEYENVVAR=OPENAI_API_KEY
# DEXICON__EMBEDDING__PROVIDERS__openai__MODELS__0=text-embedding-3-small
# DEXICON__EMBEDDING__PROVIDERS__openai__MODELS__1=text-embedding-3-large
# OPENAI_API_KEY=
#
# DEXICON__EMBEDDING__PROVIDERS__azure__KIND=AzureOpenAI
# DEXICON__EMBEDDING__PROVIDERS__azure__ENDPOINT=https://your-resource.openai.azure.com
# DEXICON__EMBEDDING__PROVIDERS__azure__APIKEYENVVAR=AZURE_OPENAI_API_KEY
# DEXICON__EMBEDDING__PROVIDERS__azure__MODELS__0=text-embedding-3-small
# AZURE_OPENAI_API_KEY=
#
# A chunk set records WHICH provider it uses, by name. Credentials stay here.

# Parallel embedding requests against Ollama.
DEXICON_EMBEDDING_MAXCONCURRENCY=4

# ── Indexing ──────────────────────────────────────────────────────────────────

# Default per-source file size cap in bytes (256 KB). Files over it are recorded
# as skipped with a reason, never silently dropped.
DEXICON_INDEXING_MAXFILEBYTES=262144

# Automatic refresh interval in minutes. 0 = manual only (UI button or the
# index_refresh MCP tool).
DEXICON_INDEXING_REFRESHMINUTES=0

# Maximum upload size in bytes (200 MB).
DEXICON_UPLOAD_MAXFILEBYTES=209715200

# ── Bootstrap ─────────────────────────────────────────────────────────────────

# Tenant created on first run.
DEXICON_BOOTSTRAP_TENANT=default

# Leave BLANK to have Dexicon generate a token on first run and print it to the
# container log exactly once:
#     docker compose logs dexicon | grep "bootstrap token"
# Set it only if you need a known value (CI, scripted setup). It is a SECRET —
# a value here lives in .env, which is gitignored and never committed.
DEXICON_BOOTSTRAP_TOKEN=

# ── Secrets ───────────────────────────────────────────────────────────────────

# Qdrant API key.
#
# DO NOT set this to an empty value. Qdrant enables authentication on the PRESENCE
# of QDRANT__SERVICE__API_KEY, not on it being non-empty — an empty string turns
# auth ON with a key nothing can match, and every request, including Qdrant's own
# dashboard, gets a 401. Leaving the line below commented out is safe: compose
# falls back to a known development default.
#
# Generate a real one for anything beyond a single trusted machine:
#     openssl rand -base64 32
# or on Windows:
#     [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
#
# QDRANT_API_KEY=

# ── Image pinning ─────────────────────────────────────────────────────────────

QDRANT_TAG=v1.16.3
OLLAMA_TAG=0.32.14
DEXICON_OWNER=merp4
DEXICON_TAG=latest

# ── Diagnostics ───────────────────────────────────────────────────────────────

# Trace | Debug | Information | Warning | Error
DEXICON_LOG_LEVEL=Information

# ── GPU ───────────────────────────────────────────────────────────────────────

# Which GPU the embedder uses, as `nvidia-smi -L` numbers them. Read ONLY when the GPU
# overlay is applied; without it Ollama embeds on the CPU and says so nowhere:
#
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
DEXICON_GPU_DEVICE_IDS=0
