# Dexicon environment
#
# Copy to .env and edit:   cp .env.example .env
#
# SECRETS MODEL — secrets are NEVER committed. This template is the only tracked
# file; `.env` and `secrets/` are gitignored. Docker Compose reads `.env`
# automatically and substitutes ${VAR} into docker-compose.yml at runtime, so real
# values reach the containers without ever entering the repository.
# See docs/10-security-secrets.md.
#
# Every variable below has a working default. A fresh `docker compose up -d` with an
# unedited copy of this file will start.
#
# Names here are the ones docker-compose.yml reads. It passes each to the container as
# DEXICON__SECTION__KEY, but only the variables it lists: a DEXICON__* line added to this
# file reaches nothing (see "Embedding providers" below for the case that matters).

# ── What to index ─────────────────────────────────────────────────────────────

# Host directory bind-mounted READ-ONLY at /workspaces inside the container.
# Point this at the parent folder of the repositories you want indexed; Dexicon
# can only see paths underneath it. If the default, ./workspaces, does not exist, Docker
# creates it empty on the first start.
WORKSPACE_ROOT=./workspaces

# ── Network exposure ──────────────────────────────────────────────────────────

# Host port for the UI, REST API and MCP endpoint. Deliberately not 8080.
DEXICON_PORT=8477

# Bind address. Leave as loopback unless you need to reach Dexicon from another
# machine; there is no TLS, so the admin password and API keys cross the network in clear.
DEXICON_BIND=127.0.0.1

# Qdrant and Ollama publish NO host ports. To reach them for debugging, use the
# debug overlay, which maps them to non-standard ports:
#   docker compose -f docker-compose.yml -f docker-compose.debug.yml up -d

# ── Embedding ─────────────────────────────────────────────────────────────────

# Default model for new corpora. Pinned per chunk set at creation; changing this does
# not migrate existing corpora (that is an explicit rebuild). Candidates and the
# trade-offs are in docs/04-ingestion.md.
# Won both retrieval sweeps (docs/benchmarks.md). `nomic-embed-text` is about half the
# download and measurably worse on code; `mxbai-embed-large` is close behind and accepts
# 2,816 characters per chunk, well above a 256-token chunk.
DEXICON_EMBEDDING_MODEL=embeddinggemma

# ── Embedding providers ──────────────────────────────────────────────────────
# Ollama is configured by default and needs nothing here. A hosted provider is named by
# its kind and the ENVIRONMENT VARIABLE that holds its key, never the key itself. Those
# settings are DEXICON__* names, which docker-compose.yml does not pass from this file, so
# they go in docker-compose.override.yml (gitignored, applied automatically):
#
#   services:
#     dexicon:
#       environment:
#         DEXICON__EMBEDDING__PROVIDERS__openai__KIND: OpenAI
#         DEXICON__EMBEDDING__PROVIDERS__openai__APIKEYENVVAR: OPENAI_API_KEY
#         DEXICON__EMBEDDING__PROVIDERS__openai__MODELS__0: text-embedding-3-small
#         OPENAI_API_KEY: ${OPENAI_API_KEY}
#
# and the key itself goes here, where Compose substitutes it:
#
# OPENAI_API_KEY=
#
# For Azure OpenAI use KIND: AzureOpenAI, add ...__azure__ENDPOINT: https://your-resource.openai.azure.com
# and name AZURE_OPENAI_API_KEY in APIKEYENVVAR. A chunk set records WHICH provider it
# uses, by name. Credentials stay out of the override file, which would otherwise hold them.

# Parallel embedding requests against Ollama. Keep it equal to OLLAMA_NUM_PARALLEL
# below: sending more than Ollama will admit just puts the difference in a queue.
#
# Counted per provider across every indexing job, not per call, so raising the number of
# corpora indexed at once does not multiply the load on this endpoint. A corpus indexing
# alone still gets all of it.
DEXICON_EMBEDDING_MAXCONCURRENCY=4

# How many requests Ollama admits at once. Left unset it admits one, and the embedder
# waits between them — measured against a live index, 50% busy unset against 79% at 4,
# about 63% more embed calls in the same window. It is not parallel decoding: Ollama
# pins an embedding model to one sequence either way, so this costs no VRAM and does not
# change the context each request gets. It removes the gap between requests, which
# matters because one embed averages 25-27 ms.
OLLAMA_NUM_PARALLEL=4

# ── Indexing ──────────────────────────────────────────────────────────────────

# Chunk size and overlap in tokens for a NEW corpus. An existing chunk set stores its own,
# so changing these migrates nothing and costs no reindex: add a set on the new size, or
# rebuild, if you want them applied to content already indexed.
#
# 256 is measured rather than chosen. Scored on whether the text handed back contains the
# answer, rather than on which file ranked first, 256-token chunks answered 0.527 of 55
# questions against 0.291 for 768 at a 1,500-character budget, converging at 6,000. The
# overlap is the same eighth of the chunk the old default was; sweeping it found nothing
# to gain from more. See docs/decisions.md D-31 and its amendment.
#
# Allowed: a size from 64 to 8192, and an overlap from 0 to one less than the size. Outside
# that, startup logs an error naming the setting as the container sees it (for example
# DEXICON__INDEXING__CHUNKSIZE, which DEXICON_INDEXING_CHUNKSIZE sets) and a corpus created
# without chunk settings of its own is refused with 503 until it is corrected.
DEXICON_INDEXING_CHUNKSIZE=256
DEXICON_INDEXING_CHUNKOVERLAP=32

# Default per-source file size cap in bytes (256 KB). Files over it are recorded
# as skipped with a reason, never silently dropped.
DEXICON_INDEXING_MAXFILEBYTES=262144

# Size cap for formats that go through an extractor — PDF, EPUB, DOCX, PPTX (512 MB).
# Separate from the cap above because a 300-page PDF is normal and a 300 KB source file is
# not. Extraction holds the document's TEXT in memory, so this is a memory decision: raise
# it if you index very large books and have the RAM. A file over it is reported as skipped
# with its size and the cap.
DEXICON_INDEXING_DOCUMENTMAXBYTES=536870912

# How long one file may spend in extraction before it is abandoned (5 minutes). 0 disables
# the limit. A workspace file is recorded as failed and tried again on a later refresh; an
# uploaded file is listed under failed in the upload response and no document record is
# created. Extraction calls into libraries that take no
# cancellation token, so without this a single unreadable document holds the corpus and
# everything queued behind it. The slowest healthy file measured here is 13s for an 84 MB
# PDF; the limit is for the pathological case rather than the large one.
DEXICON_INDEXING_EXTRACTIONTIMEOUTSECONDS=300

# Automatic refresh interval in minutes. 0 = manual only (UI button or the
# index_refresh MCP tool).
DEXICON_INDEXING_REFRESHMINUTES=0

# How many corpora may be indexed at once. Indexing was one job at a time, so a corpus
# that takes hours owned the machine: a 1,834-file library measured 13.7 hours to
# refresh and a sixteen-file corpus queued behind it waited all of that. Two jobs on ONE
# corpus are still excluded, by the lease rather than by the queue.
#
# Raising this does not multiply the load on the embedding endpoint or the parser, which
# are bounded separately. It multiplies catalogue connections and the memory held by
# in-flight documents.
DEXICON_INDEXING_MAXCONCURRENTCORPORA=4

# How many files may be parsed at once, across every job. Extraction is CPU-bound
# parsing, so the limit is the machine's rather than a corpus's. One corpus indexing
# alone may use all of it.
DEXICON_INDEXING_MAXCONCURRENTEXTRACTIONS=4

# How many discovery passes may run at once. A sweep walks a corpus and records what is
# in it without extracting or embedding, and it has its own limit so that it never waits
# behind indexing: a corpus added while another indexes would otherwise read as empty for
# as long as that took. More than a couple contend for the catalogue's single writer to
# finish a two-second walk marginally sooner.
DEXICON_INDEXING_MAXCONCURRENTSWEEPS=2

# How many FULL or rebuild passes may run at once, as opposed to incremental ones.
# Deliberately below MAXCONCURRENTCORPORA: a rebuild re-embeds every file it walks, so
# several together saturate the embedding endpoint and slow each other without finishing
# any sooner. Incremental passes keep their own slots while one runs.
DEXICON_INDEXING_MAXCONCURRENTREBUILDS=1

# Maximum size of one uploaded file in bytes (200 MB). One upload request may carry ten
# files at this size, plus 1 MiB of framing.
DEXICON_UPLOAD_MAXFILEBYTES=209715200

# ── Bootstrap ─────────────────────────────────────────────────────────────────

# The admin password: the only way to reach the UI and the only route to the
# `admin` scope. Leave BLANK to have Dexicon generate one on first run and print
# it to the container log exactly once, in double quotes, two lines below a box
# headed "Dexicon admin password":
#     docker compose logs dexicon | grep -A 2 "admin password"
# Set here, it is applied on every start, which is also the way back in after a
# forgotten one. Nothing in the UI or API changes it. It is a SECRET: a value here
# lives in .env, which is gitignored and never committed.
DEXICON_ADMIN_PASSWORD=

# A pinned API key, for scripted setup and CI: somewhere that has to reach the
# MCP surface with a known credential and no browser to create one in.
#
# Leave BLANK and nothing is minted. Sign in with the password above and issue a
# key under Access, which is also where you choose the corpora it reaches and
# copy the `claude mcp add` command.
#
# Set here, it must be a well-formed dex_<id>_<secret> and is adopted with
# `search` and `ingest`. It is a SECRET: a value here lives in .env, which is
# gitignored and never committed.
DEXICON_BOOTSTRAP_TOKEN=

# ── Secrets ───────────────────────────────────────────────────────────────────

# Qdrant API key.
#
# DO NOT set this to an empty value. Qdrant enables authentication on the PRESENCE
# of QDRANT__SERVICE__API_KEY, not on it being non-empty — an empty string turns
# auth ON with a key nothing can match, and every request, including Qdrant's own
# dashboard, gets a 401. Leaving the line below commented out is safe: compose
# falls back to a known development default.
#
# Generate a real one for anything beyond a single trusted machine:
#     openssl rand -base64 32
# or on Windows:
#     [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
#
# QDRANT_API_KEY=

# ── Image pinning ─────────────────────────────────────────────────────────────

QDRANT_TAG=v1.16.3
OLLAMA_TAG=0.32.14
DEXICON_OWNER=merp4
# A release version (0.6.7) or `latest`. `latest` is whatever image is already on the
# machine until `docker compose pull` fetches a newer one; see docs/09-deployment.md,
# "Upgrading".
DEXICON_TAG=latest

# ── Diagnostics ───────────────────────────────────────────────────────────────

# Trace | Debug | Information | Warning | Error
DEXICON_LOG_LEVEL=Information

# ── GPU ───────────────────────────────────────────────────────────────────────

# Which GPU the embedder uses, as `nvidia-smi -L` numbers them. Read ONLY when the GPU
# overlay is applied; without it Ollama embeds on the CPU and says so nowhere:
#
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
DEXICON_GPU_DEVICE_IDS=0
