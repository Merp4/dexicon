<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Caching.Memory, DependencyInjection.Abstractions, Hosting.Abstractions, Http and
         Logging.Abstractions come from the ASP.NET Core shared framework in the runtime image,
         so there is no package or pin for them. Separate pins that disagreed after a servicing
         release failed restore with NU1109 (#257, #276). Only the web host and the tests
         consume this library. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Qdrant.Client" />
    <PackageReference Include="Ulid" />
    <PackageReference Include="VersOne.Epub" />
  </ItemGroup>

  <ItemGroup>
    <!-- SparseEncoder.Hash and CodeChunker.TryReadHeading are internal contracts that
         still need pinning: a change to either silently invalidates every index or
         mislabels every section. Tested without widening the public API. -->
    <InternalsVisibleTo Include="Dexicon.Tests" />
  </ItemGroup>

</Project>
