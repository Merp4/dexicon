<Project Sdk="Microsoft.NET.Sdk">

  <!-- A throwaway tool for scripts/bench/functionbench.py: it writes the chunks `CodeChunker` makes, one JSON object per line.
       It is not in Dexicon.slnx, so a build or test of the solution does not touch it. Build it once against each chunker to
       compare (`dotnet build scripts/bench/chunkjson -c Release -o <dir>`), checking out the chunker under test first. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Dexicon.Core/Dexicon.Core.csproj" />
  </ItemGroup>

</Project>
