+    /// <summary>
+    /// Moves each member boundary up over the unbroken run of comment and attribute lines directly above it, so a
+    /// member's description and attributes begin the segment the member is in. A boundary is the member's signature line,
+    /// and without this the lines above it end the previous segment: a chunk that breaks at the boundary then carries the
+    /// next member's description at its tail and leaves that member without it. A blank line ends the run.
+    /// </summary>
+    private static List<int> AttachLeadingLines(List<int> boundaries, string[] lines, string leadingPattern)
+    {
+        var leading = new Regex(leadingPattern, RegexOptions.None, RegexTimeout);
+        var signatures = boundaries.ToHashSet();
+        var moved = new SortedSet<int>();
+
+        foreach (var signature in boundaries)
+        {
+            var start = signature;
+            try
+            {
+                while (start > 0 && !signatures.Contains(start - 1) && leading.IsMatch(lines[start - 1])) start--;
+            }
+            catch (RegexMatchTimeoutException ex)
+            {
+                throw new ArgumentException(
+                    $"Leading-line regex timed out after {RegexTimeout.TotalMilliseconds}ms above line {signature + 1}.", ex);
+            }
+
+            // Line 0 starts the first segment whether or not it is a boundary.
+            if (start > 0) moved.Add(start);
+        }
+
+        return [.. moved];
     }
 
