<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Warnings are errors. A project that tolerates warnings accumulates them until
         nobody reads the build output, and the one that mattered scrolls past. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- The development default, overridden by the release build with the git tag
         (`/p:Version=1.2.3`). It is not decoration: it is what the OpenAPI document
         and the MCP server report as their version, and an unset one reported 1.0.0
         for a project that has never had a 1.0. -->
    <Version>0.1.0</Version>

    <Product>Dexicon</Product>
    <Company>Dexicon</Company>
    <Copyright>Copyright 2026 Martyn Mcvay</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Merp4/dexicon</RepositoryUrl>

    <!-- Deterministic builds in CI so the same source produces the same bytes. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Test projects are held to the same warning bar but need xunit's analyzers. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
